# ---------------------------------------------------------------------------
# Inforvio Project Management — environment template
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is committed.
# Every variable is read exactly once, in `src/lib/env.ts`, which throws at boot
# if a required one is missing.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# MySQL connection string. Read by BOTH the Prisma CLI (via prisma.config.ts)
# and the runtime client (via the @prisma/adapter-mariadb driver adapter).
#
# Prisma 7 no longer accepts `url` in schema.prisma, which is why this is the
# only place the connection string lives.
DATABASE_URL="mysql://root@127.0.0.1:3306/inforvio_pm"

# --- Auth.js ----------------------------------------------------------------
# Generate with: npx auth secret
# Signs the session cookie. Changing it invalidates every existing session.
AUTH_SECRET=""

# Google OAuth client (APIs & Services -> Credentials -> OAuth client ID -> Web).
# The Authorized redirect URI registered in Google Cloud Console must be
# EXACTLY, for local dev:
#     http://localhost:3000/api/auth/callback/google
# and for production:
#     https://<your-host>/api/auth/callback/google
# Requested scopes are openid, email, profile — nothing more.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional. Pre-filters Google's account chooser to one Workspace domain.
# UX CONVENIENCE ONLY — `hd` is attacker-controllable and is NOT a security
# control. The allowlist check in the signIn callback is the sole enforcement.
# GOOGLE_HD="inforvio.com"

# --- Bootstrap (first run only) ---------------------------------------------
# `npx prisma db seed` inserts one `allowed_domain` row per entry here, so the
# first admin can get in. After that, domains are managed in Settings -> Domains
# and these variables are inert.
#
# NOTE: there is deliberately NO runtime fallback to these values. If the
# allowed_domain table is empty, nobody can sign in — a config fallback in the
# sign-in path would be an allowlist bypass.
BOOTSTRAP_ALLOWED_DOMAINS="inforvio.com"

# Emails promoted to ADMIN when they first sign in. Everyone else gets the
# matched domain's auto_role (MEMBER by default).
BOOTSTRAP_ADMIN_EMAILS="sureshkumarsr94@gmail.com"

# --- Attachment storage -----------------------------------------------------
# local | s3
STORAGE_DRIVER="local"

# Where the local driver writes files. Deliberately OUTSIDE public/ — files are
# only reachable through GET /api/v1/attachments/:id/download, which authorizes
# the caller first.
STORAGE_LOCAL_DIR="./var/uploads"

# Rejected above this size, before the body is written to disk.
MAX_UPLOAD_BYTES="26214400"

# --- Only when STORAGE_DRIVER=s3 -------------------------------------------
# The bucket MUST be private: Block Public Access on, no public bucket policy.
# Nothing in the app grants public reads — attachments are served only through
# GET /api/v1/attachments/:id/download, which authorises the caller first.
# Missing S3_BUCKET makes the app fail at boot rather than on the first upload.
# S3_BUCKET="inforvio-pm-attachments"
# S3_REGION="ap-south-1"

# Optional key prefix, so one bucket can host several environments.
# S3_PREFIX="production"

# Objects are encrypted at rest with SSE-S3 (AES256) by default. Set a KMS key
# id to use SSE-KMS instead.
# S3_KMS_KEY_ID=""

# Only for S3-compatible endpoints (MinIO, LocalStack). Leave unset for real S3
# so the SDK resolves the regional endpoint itself.
# S3_ENDPOINT="http://localhost:9000"

# As with SES, AWS credentials are deliberately absent: the SDK's default
# provider chain reads them from the environment, the shared profile, or the
# instance/task role. Production runs on an IAM role and no secret goes here.

# --- Email notifications (Amazon SES) ---------------------------------------
# log | ses
#   log — prints the whole message to the server console. The default, so local
#         development needs no AWS credentials at all.
#   ses — actually sends through Amazon SES v2.
MAIL_DRIVER="log"

# Sender address. MUST be an identity you have verified in SES (the address
# itself, or its domain). Required when MAIL_DRIVER=ses.
MAIL_FROM="Inforvio PM <no-reply@loanwiser.in>"

SES_REGION="ap-south-1"

# Optional but strongly recommended in production: an SES configuration set is
# what routes bounces and complaints to SNS. Without one, repeated bounces
# quietly damage your sending reputation.
# SES_CONFIGURATION_SET="inforvio-pm"

# Absolute base URL used to build links inside emails. Emails are read outside
# the app, so a relative path is useless — set this to the real host in prod.
APP_URL="http://localhost:3000"

# NOTE: AWS credentials are deliberately NOT listed here. The SDK's default
# provider chain reads them from the environment, the shared profile, or the
# instance/task role — so production runs on an IAM role with ses:SendEmail and
# no secret ever lands in this file.

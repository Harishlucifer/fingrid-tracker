# Copy to .env and fill in. See README.md for the reasoning behind any of this.

# --- Database ---------------------------------------------------------------
# Only DB_NAME is required; the rest default to these values.
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_USER="root"
DB_PASS=""
DB_NAME="inforvio_pm"

# --- Auth -------------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=""

# Google Cloud Console -> Credentials -> OAuth client ID -> Web application.
# Authorized redirect URI must be exactly:
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Pre-filters Google's account chooser. UX hint only, not a security control.
# GOOGLE_HD="loanwiser.in"

# --- First run --------------------------------------------------------------
# `npm run db:seed` writes these into the allowed_domain table so the first
# admin can sign in. Inert afterwards — domains are managed in Settings.
BOOTSTRAP_ALLOWED_DOMAINS="loanwiser.in"
BOOTSTRAP_ADMIN_EMAILS="sureshkumar@loanwiser.in"

# --- Attachments: S3 (no local fallback) ------------------------------------
# The bucket must be PRIVATE — Block Public Access on.
# This key needs only s3:{Put,Get,Delete}Object on the bucket.
# Set both keys or neither; setting one is an error.
S3_BUCKET=""
S3_REGION="ap-south-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
MAX_UPLOAD_BYTES="26214400"

# S3_SESSION_TOKEN=""             # temporary STS credentials only
# S3_PREFIX="production"          # share one bucket across environments
# S3_KMS_KEY_ID=""                # SSE-KMS instead of the SSE-S3 default
# S3_ENDPOINT=""                  # MinIO/LocalStack only

# --- Email: SES -------------------------------------------------------------
# log = print to console (no AWS needed) | ses = send for real
MAIL_DRIVER="log"

# MAIL_FROM must be an identity verified in SES.
# This key needs only ses:SendEmail.
MAIL_FROM="Inforvio PM <no-reply@loanwiser.in>"
SES_REGION="ap-south-1"
SES_ACCESS_KEY_ID=""
SES_SECRET_ACCESS_KEY=""

# SES_SESSION_TOKEN=""            # temporary STS credentials only
# SES_CONFIGURATION_SET=""        # routes bounces/complaints to SNS

# --- Shared AWS key (optional) ----------------------------------------------
# Used by any service whose own key above is unset. Leave blank to use one key
# per service, or blank everywhere to fall back to an EC2/ECS instance role.
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# Base URL for links in emails. Set to the real host in production.
APP_URL="http://localhost:3000"
